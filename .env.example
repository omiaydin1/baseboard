# ---- BaseBoard environment variables ----
# All are optional for local dev: the app runs in "demo" mode without them,
# but on-chain reads/writes require a deployed contract address.

# Deployed BaseBoard.sol address on Base Mainnet (8453).
NEXT_PUBLIC_BASEBOARD_CONTRACT_ADDRESS=
# Block Base contract was deployed at (fromBlock for log scans).
NEXT_PUBLIC_BASEBOARD_DEPLOY_BLOCK=

# ---- Celo Mainnet (42220) ----
# Deployed BaseBoard.sol address on Celo (placeholder until deployed).
NEXT_PUBLIC_CELO_CONTRACT_ADDRESS=
# Treasury that receives Celo mint fees (must match the on-chain TREASURY).
NEXT_PUBLIC_CELO_TREASURY_ADDRESS=
# Flat plot price on Celo, in CELO (≈ $0.001 equivalent).
NEXT_PUBLIC_CELO_PLOT_PRICE=
# Block the Celo contract was deployed at (fromBlock for log scans).
NEXT_PUBLIC_CELO_DEPLOY_BLOCK=
# Optional ENS-compatible universal resolver for Celo Name Service (.celo)
# reverse lookups. When set, connected Celo accounts show their .celo name;
# otherwise the UI falls back to the short hex address.
NEXT_PUBLIC_CELO_NAME_RESOLVER=

# Coinbase Developer Platform / OnchainKit client API key.
# https://portal.cdp.coinbase.com/
NEXT_PUBLIC_ONCHAINKIT_API_KEY=

# WalletConnect project id (optional — enables the WalletConnect connector).
# https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---- Deployment only (used by Hardhat, never shipped to the browser) ----
# Deployer private key with a small amount of Base ETH for gas.
# Put this in a local `.env` file (gitignored), NOT here.
PRIVATE_KEY=

# Optional custom Base RPC (defaults to https://mainnet.base.org).
BASE_RPC_URL=
